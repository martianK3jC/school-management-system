<div class="nav-scrollable hidden peer-checked:block desktop:block desktop:flex-1 desktop:min-h-0 desktop:overflow-y-auto"
     onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="school-nav flex flex-col gap-2 p-4">
        <div class="min-w-0">
