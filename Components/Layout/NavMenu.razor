        <div class="min-w-0">
            <NavLink class="menu-link flex items-center justify-center w-full min-h-14 px-4 py-3 text-[length:var(--text-lg)] no-underline rounded-none [&.active]:bg-white/25 [&:hover:not(.active)]:bg-white/10 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-[-3px]"
                     href="learners">
                Learners
            </NavLink>
        </div>

        <div class="min-w-0">
            <NavLink class="menu-link flex items-center justify-center w-full min-h-14 px-4 py-3 text-[length:var(--text-lg)] no-underline rounded-none [&.active]:bg-white/25 [&:hover:not(.active)]:bg-white/10 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-[-3px]"
