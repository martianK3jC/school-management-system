@page "/sections"

<PageTitle>Sections</PageTitle>

<div class="space-y-6">
    <nav aria-label="Breadcrumb" class="text-sm">
        <a href="">Home</a>
        <span class="mx-2">→</span>
        <span>Sections</span>
    </nav>

    <header class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-[length:var(--text-display)] text-[color:var(--text-primary)]">
                Sections
            </h1>
            <p>Here's what's happening at your school today.</p>
        </div>
        <button type="button" disabled
                class="bg-odyssey px-4 py-3 text-white disabled:opacity-60">
            + Add Section
        </button>
    </header>

    <div class="flex flex-wrap items-center gap-3">
        <select aria-label="Grade level"
                class="border border-seabreeze bg-white px-3 py-3">
            <option>All Grade Levels</option>
        </select>

        <input type="search"
               aria-label="Search sections"
               placeholder="Search section by name or adviser..."
               class="min-w-0 flex-1 basis-64 border border-seabreeze bg-white px-3 py-3 focus:outline-2 focus:outline-odyssey" />

        <select aria-label="Adviser"
                class="border border-seabreeze bg-white px-3 py-3">
            <option>All Advisers</option>
        </select>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @for (var card = 1; card <= 6; card++)
        {
            <section class="border border-seabreeze bg-lagoon/20 p-5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="text-2xl font-semibold">A</h2>
                        <p class="font-semibold">Grade 1</p>
                    </div>
                    <span aria-hidden="true" class="text-2xl">⋮</span>
                </div>

                <p class="mt-3">31 learners</p>

                <div class="mt-4 border-t border-seabreeze pt-4">
                    <p class="font-semibold">Ms. Reyes</p>
                    <p class="text-sm text-[color:var(--text-secondary)]">
                        Class Adviser
                    </p>
                </div>
            </section>
        }
    </div>

    <section class="border border-seabreeze bg-white p-5">
        <header class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold">Grade 1 - A</h2>
                <p class="text-sm">31 learners | Adviser: Ms. Reyes</p>
            </div>

            <div class="flex flex-wrap gap-2">
                <button type="button" disabled
                        class="border border-seabreeze px-3 py-2 disabled:opacity-60">
                    Take Attendance
                </button>
                <button type="button" disabled
                        class="border border-seabreeze px-3 py-2 disabled:opacity-60">
                    View Class Record
                </button>
            </div>
        </header>

        <div class="mt-6 flex flex-wrap gap-5 border-b border-seabreeze">
            <span class="border-b-2 border-odyssey pb-3 font-semibold text-odyssey">
                Learners
            </span>
            <span class="pb-3 text-[color:var(--text-muted)]">Attendance</span>
            <span class="pb-3 text-[color:var(--text-muted)]">Class Record</span>
            <span class="pb-3 text-[color:var(--text-muted)]">
                Adviser Information
            </span>
        </div>

        <div class="my-4 flex flex-wrap items-center justify-between gap-3">
            <input type="search"
                   aria-label="Search section learners"
                   placeholder="Search learner name or LRN..."
                   class="min-w-0 flex-1 basis-64 border border-seabreeze px-3 py-3 focus:outline-2 focus:outline-odyssey" />

            <button type="button" disabled
                    class="bg-odyssey px-4 py-3 text-white disabled:opacity-60">
                + Add Learner
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[800px] text-left text-sm">
                <thead class="bg-seabreeze">
                    <tr>
                        <th scope="col" class="px-4 py-3">#</th>
                        <th scope="col" class="px-4 py-3">Learner Name</th>
                        <th scope="col" class="px-4 py-3">LRN</th>
                        <th scope="col" class="px-4 py-3">Grade Level</th>
                        <th scope="col" class="px-4 py-3">Section</th>
                        <th scope="col" class="px-4 py-3">Status</th>
                        <th scope="col" class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var row = 1; row <= 5; row++)
                    {
                        <tr class="border-b border-seabreeze">
                            <td class="px-4 py-3">@row</td>
                            <td class="px-4 py-3 font-semibold">Learner Name</td>
                            <td class="px-4 py-3">12345678987</td>
                            <td class="px-4 py-3">Grade Level</td>
                            <td class="px-4 py-3">Section</td>
                            <td class="px-4 py-3">
                                <span class="bg-lagoon/25 px-2 py-1">Enrolled</span>
                            </td>
                            <td class="px-4 py-3 text-xs">[view] [edit] [more]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
