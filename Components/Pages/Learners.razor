@page "/learners"

<PageTitle>Learners</PageTitle>

<div class="space-y-6">
    <nav aria-label="Breadcrumb" class="text-sm">
        <a href="">Home</a>
        <span class="mx-2">→</span>
        <span>Learners</span>
    </nav>

    <header class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-[length:var(--text-display)] text-[color:var(--text-primary)]">
                Learners
            </h1>
            <p>Here's what's happening at your school today.</p>
        </div>
        <button type="button" disabled
                class="bg-odyssey px-4 py-3 text-white disabled:opacity-60">
            + Add Learner
        </button>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <section class="bg-lagoon/30 p-5">
            <h2 class="text-base font-semibold">Enrolled Learners</h2>
            <p class="mt-3 text-3xl font-semibold">428</p>
        </section>
        <section class="bg-moss/20 p-5">
            <h2 class="text-base font-semibold">Male</h2>
            <p class="mt-3 text-3xl font-semibold">218</p>
        </section>
        <section class="bg-guava/30 p-5">
            <h2 class="text-base font-semibold">Female</h2>
            <p class="mt-3 text-3xl font-semibold">210</p>
        </section>
        <section class="bg-butter/30 p-5">
            <h2 class="text-base font-semibold">Grade Levels</h2>
            <p class="mt-3 text-3xl font-semibold">6</p>
        </section>
        <section class="bg-seabreeze p-5">
            <h2 class="text-base font-semibold">Sections</h2>
            <p class="mt-3 text-3xl font-semibold">16</p>
        </section>
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <input type="search"
               aria-label="Search learners"
               placeholder="Search by name, LRN, or section..."
               class="min-w-0 flex-1 basis-64 border border-seabreeze bg-white px-3 py-3 focus:outline-2 focus:outline-odyssey" />

        <select aria-label="Grade level"
                class="border border-seabreeze bg-white px-3 py-3">
            <option value="">All Grade Levels</option>
        </select>

        <select aria-label="Section"
                class="border border-seabreeze bg-white px-3 py-3">
            <option value="">All Sections</option>
        </select>

        <select aria-label="Status"
                class="border border-seabreeze bg-white px-3 py-3">
            <option value="">All Status</option>
        </select>

        <button type="button" disabled
                class="bg-odyssey px-4 py-3 text-white disabled:opacity-60">
            Clear Filters
        </button>
    </div>

    <div class="overflow-x-auto border border-seabreeze bg-white">
        <table class="w-full min-w-[800px] text-left text-sm">
            <thead class="bg-seabreeze">
                <tr>
                    <th scope="col" class="px-4 py-3">#</th>
                    <th scope="col" class="px-4 py-3">Learner Name</th>
                    <th scope="col" class="px-4 py-3">LRN</th>
                    <th scope="col" class="px-4 py-3">Grade Level</th>
                    <th scope="col" class="px-4 py-3">Section</th>
                    <th scope="col" class="px-4 py-3">Status</th>
                    <th scope="col" class="px-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (var row = 1; row <= 10; row++)
                {
                    <tr class="border-b border-seabreeze">
                        <td class="px-4 py-3">@row</td>
                        <td class="px-4 py-3 font-semibold">Learner Name</td>
                        <td class="px-4 py-3">12345678987</td>
                        <td class="px-4 py-3">Grade Level</td>
                        <td class="px-4 py-3">Section</td>
                        <td class="px-4 py-3">
                            <span class="bg-lagoon/25 px-2 py-1">Enrolled</span>
                        </td>
                        <td class="px-4 py-3 text-xs">
                            [view] [edit] [more]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <footer class="flex flex-wrap items-center justify-between gap-4 text-sm">
        <p>Showing 1 - 10 of 428 learners</p>
        <div class="flex gap-2" aria-label="Pagination preview">
            <button type="button" disabled
                    class="border border-seabreeze px-3 py-2">1</button>
            <button type="button" disabled
                    class="bg-odyssey px-3 py-2 text-white">2</button>
            <button type="button" disabled
                    class="border border-seabreeze px-3 py-2">3</button>
            <span class="px-3 py-2">…</span>
            <button type="button" disabled
                    class="border border-seabreeze px-3 py-2"
                    aria-label="Next page">→</button>
        </div>
    </footer>
</div>