@implements IDisposable
@page "/learners"
@rendermode InteractiveServer
@inject ILogger<Learners> Logger
@inject ILearnerService LearnerService
@inject ISectionService SectionService
@using System.ComponentModel.DataAnnotations
@using SchoolManagementSystem.Modules.Enrollment.Application

<PageTitle>Learners</PageTitle>

<div class="space-y-6">
    <nav aria-label="Breadcrumb" class="text-sm">
        <a href="">Home</a>
        <span class="mx-2">→</span>
        <span>Learners</span>
    </nav>

    <header class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-[length:var(--text-display)] text-[color:var(--text-primary)]">
                Learners
            </h1>
            <p>Browse and filter learner records.</p>
        </div>

        <button type="button"
                @onclick="OpenAddModal" disabled="@isOpeningForm"
                class="bg-odyssey px-4 py-3 text-white hover:bg-odyssey/90 focus-visible:outline-2 focus-visible:outline-odyssey focus-visible:outline-offset-2">
            + Add Learner
        </button>
    </header>

    @if (isLoading)
    {
        <p class="py-8 text-center text-[color:var(--text-muted)]">Loading learners...</p>
    }
    else if (result is not null)
    {
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <section class="bg-lagoon/30 p-5">
                <h2 class="text-base font-semibold">Enrolled Learners</h2>
                <p class="mt-3 text-3xl font-semibold">@result.EnrolledCount</p>
            </section>
            <section class="bg-moss/20 p-5">
                <h2 class="text-base font-semibold">Enrolled Male</h2>
                <p class="mt-3 text-3xl font-semibold">@result.EnrolledMaleCount</p>
            </section>
            <section class="bg-guava/30 p-5">
                <h2 class="text-base font-semibold">Enrolled Female</h2>
                <p class="mt-3 text-3xl font-semibold">@result.EnrolledFemaleCount</p>
            </section>
            <section class="bg-butter/30 p-5">
                <h2 class="text-base font-semibold">Grade Levels</h2>
                <p class="mt-3 text-3xl font-semibold">@result.DistinctGradeLevelCount</p>
            </section>
            <section class="bg-seabreeze p-5">
                <h2 class="text-base font-semibold">Sections</h2>
                <p class="mt-3 text-3xl font-semibold">@result.DistinctSectionCount</p>
            </section>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <input type="search"
                   value="@searchText"
                   @oninput="OnSearchInput"
                   aria-label="Search learners"
                   placeholder="Search by name, LRN, or section..."
                   class="min-w-0 flex-1 basis-64 border border-seabreeze bg-white px-3 py-3 focus:outline-2 focus:outline-odyssey" />

            <select @bind="selectedGradeLevelId"
                    @bind:after="FilterChanged"
                    aria-label="Grade level"
                    class="border border-seabreeze bg-white px-3 py-3">
                <option value="">All Grade Levels</option>
                @foreach (var gl in gradeLevelOptions)
                {
                    <option value="@gl.Id">@gl.Name</option>
                }
            </select>

            <select @bind="selectedSection"
                    @bind:after="FilterChanged"
                    aria-label="Section"
                    class="border border-seabreeze bg-white px-3 py-3">
                <option value="">All Sections</option>
                @foreach (var option in sectionOptions)
                {
                    <option value="@option.Id">@option.DisplayName</option>
                }
            </select>

            <select @bind="selectedStatus"
                    @bind:after="FilterChanged"
                    aria-label="Status"
                    class="border border-seabreeze bg-white px-3 py-3">
                <option value="">All Statuses</option>
                <option value="Enrolled">Enrolled</option>
                <option value="Transferred">Transferred</option>
                <option value="Withdrawn">Withdrawn</option>
                <option value="Graduated">Graduated</option>
            </select>

            <button type="button"
                    @onclick="ClearFilters"
                    class="bg-odyssey px-4 py-3 text-white hover:bg-odyssey/90 focus-visible:outline-2 focus-visible:outline-odyssey focus-visible:outline-offset-2">
                Clear Filters
            </button>
        </div>

        <div class="overflow-x-auto border border-seabreeze bg-white">
            <table class="learner-table w-full min-w-[800px] text-left text-sm">
                <thead class="bg-seabreeze">
                    <tr>
                        <th scope="col" class="px-4 py-3">#</th>
                        <th scope="col" class="px-4 py-3">Learner Name</th>
                        <th scope="col" class="px-4 py-3">LRN</th>
                        <th scope="col" class="px-4 py-3">Sex</th>
                        <th scope="col" class="px-4 py-3">Grade Level</th>
                        <th scope="col" class="px-4 py-3">Section</th>
                        <th scope="col" class="px-4 py-3">Status</th>
                        <th scope="col" class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (result.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-8 text-center">
                                No learners found. Try another search or clear the filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNumber = (result.Page - 1) * result.PageSize;

                        @foreach (var learner in result.Items)
                        {
                            rowNumber++;

                            <tr @key="learner.Id" class="border-b border-seabreeze">
                                <td class="px-4 py-3">@rowNumber</td>
                                <td class="px-4 py-3 font-semibold">@learner.FullName</td>
                                <td class="px-4 py-3 break-all" title="@learner.Lrn">@learner.Lrn</td>
                                <td class="px-4 py-3">@learner.Sex</td>
                                <td class="px-4 py-3">@learner.GradeLevelName</td>
                                <td class="px-4 py-3">@learner.SectionName</td>
                                <td class="px-4 py-3">@learner.Status</td>
                                <td class="px-4 py-3"><div class="flex gap-2">
                                    <button type="button"
                                            @onclick="() => OpenEditModal(learner.Id)" disabled="@isOpeningForm"
                                            class="text-odyssey hover:underline">
                                        Edit
                                    </button>
                                    <button type="button"
                                            @onclick="() => ConfirmDelete(learner.Id, learner.FullName)"
                                            class="text-sangria hover:underline">
                                        Delete
                                    </button>
                                </div></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <p role="status" class="text-sm">
            Showing @result.Items.Count of @result.FilteredCount matching learner records (@result.TotalCount total).
            Page @result.Page of @Math.Max(1, (int)Math.Ceiling(result.FilteredCount / (double)result.PageSize)).
            <button type="button" class="ml-3 underline" disabled="@(result.Page <= 1)" @onclick="PreviousPage">Previous</button>
            <button type="button" class="ml-3 underline" disabled="@(result.Page * result.PageSize >= result.FilteredCount)" @onclick="NextPage">Next</button>
        </p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div role="alert" class="border border-sangria/30 bg-sangria/10 p-4 text-sangria">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div role="status" class="border border-palm/30 bg-palm/10 p-4 text-palm">
            @successMessage
        </div>
    }
</div>

@if (showFormModal)
{
    <dialog class="modal-shell" data-school-modal aria-labelledby="form-title" @onclick="CloseModal">
        <div class="w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-white p-6 shadow-xl"
             @onclick:stopPropagation>
            <h2 id="form-title" class="mb-4 text-xl font-semibold">
                @(isEditMode ? "Edit Learner" : "Add Learner")
            </h2>

            @if (!string.IsNullOrEmpty(previousSectionName) && formModel.SectionId is null)
            {
                <p role="status" class="mb-4 bg-butter/30 p-3">
                    Please confirm this learner's section. Their previous section was <strong>@previousSectionName</strong>.
                    Choose a section below, or leave it blank to remove the previous assignment.
                </p>
            }

            <EditForm Model="formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="mb-4 text-sm text-sangria" />
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p role="alert" class="mb-4 text-sangria">@errorMessage</p>
                }

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="formModel-FirstName" class="mb-1 block text-sm font-medium">First Name *</label>
                        <InputText id="formModel-FirstName" @bind-Value="formModel.FirstName"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                        <ValidationMessage For="() => formModel.FirstName" />
                    </div>
                    <div>
                        <label for="formModel-MiddleName" class="mb-1 block text-sm font-medium">Middle Name</label>
                        <InputText id="formModel-MiddleName" @bind-Value="formModel.MiddleName"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                    </div>
                    <div>
                        <label for="formModel-LastName" class="mb-1 block text-sm font-medium">Last Name *</label>
                        <InputText id="formModel-LastName" @bind-Value="formModel.LastName"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                        <ValidationMessage For="() => formModel.LastName" />
                    </div>
                    <div>
                        <label for="formModel-Lrn" class="mb-1 block text-sm font-medium">LRN *</label>
                        <InputText id="formModel-Lrn" @bind-Value="formModel.Lrn" inputmode="numeric" maxlength="12"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                        <ValidationMessage For="() => formModel.Lrn" />
                    </div>
                    <div>
                        <label for="formModel-Sex" class="mb-1 block text-sm font-medium">Sex *</label>
                        <InputSelect id="formModel-Sex" @bind-Value="formModel.Sex"
                                     class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey">
                            <option value="">Select...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </InputSelect>
                        <ValidationMessage For="() => formModel.Sex" />
                    </div>
                    <div>
                        <label for="formModel-BirthDate" class="mb-1 block text-sm font-medium">Birth Date *</label>
                        <InputDate id="formModel-BirthDate" @bind-Value="formModel.BirthDate"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                        <ValidationMessage For="() => formModel.BirthDate" />
                    </div>
                    <div>
                        <label for="formModel-GradeLevelId" class="mb-1 block text-sm font-medium">Grade Level *</label>
                        <select id="formModel-GradeLevelId" @bind="formModel.GradeLevelId" @bind:after="FormGradeChanged"
                                class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey">
                            <option value="@Guid.Empty">Select...</option>
                            @foreach (var gl in gradeLevelOptions)
                            {
                                <option value="@gl.Id">@gl.Name</option>
                            }
                        </select>
                        @if (formModel.GradeLevelId == Guid.Empty)
                        {
                            <span class="text-sm text-sangria">Grade level is required.</span>
                        }
                    </div>
                    <div>
                        <label for="formModel-SectionId" class="mb-1 block text-sm font-medium">Section</label>
                        <select id="formModel-SectionId" @bind="formModel.SectionId"
                                class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey">
                            <option value="">Select a section...</option>
                            @foreach (var option in FormSections)
                            {
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </select>
                        @if (formModel.GradeLevelId == Guid.Empty)
                        {
                            <p class="mt-2 text-sm text-[color:var(--text-secondary)]">Choose a grade level to see its sections.</p>
                        }
                        else if (!FormSections.Any())
                        {
                            <p class="mt-2 text-sm text-[color:var(--text-secondary)]">
                                No active sections are available for @gradeLevelOptions.FirstOrDefault(g => g.Id == formModel.GradeLevelId)?.Name.
                                Create an active section for this grade on the Sections page, then reopen this form.
                            </p>
                        }

                    </div>
                    @if (isEditMode)
                    {
                        <div>
                            <label for="editStatus" class="mb-1 block text-sm font-medium">Status</label>
                        <InputSelect id="editStatus" @bind-Value="editStatus"
                                         class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey">
                                <option value="Enrolled">Enrolled</option>
                                <option value="Transferred">Transferred</option>
                                <option value="Withdrawn">Withdrawn</option>
                                <option value="Graduated">Graduated</option>
                            </InputSelect>
                        </div>
                    }
                    <div>
                        <label for="formModel-GuardianName" class="mb-1 block text-sm font-medium">Guardian Name</label>
                        <InputText id="formModel-GuardianName" @bind-Value="formModel.GuardianName"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                    </div>
                    <div>
                        <label for="formModel-GuardianContact" class="mb-1 block text-sm font-medium">Guardian Contact</label>
                        <InputText id="formModel-GuardianContact" @bind-Value="formModel.GuardianContact"
                                   class="w-full border border-seabreeze px-3 py-2 focus:outline-2 focus:outline-odyssey" />
                    </div>
                </div>

                <div class="mt-6 flex justify-end gap-3">
                    <button type="button"
                            @onclick="CloseModal"
                            class="border border-seabreeze px-4 py-2 hover:bg-seabreeze/50">
                        Cancel
                    </button>
                    <button type="submit"
                            disabled="@isSubmitting"
                            class="bg-odyssey px-4 py-2 text-white hover:bg-odyssey/90 disabled:opacity-60">
                        @(isSubmitting ? "Saving..." : (isEditMode ? "Update" : "Add"))
                    </button>
                </div>
            </EditForm>
        </div>
    </dialog>
}

@if (showDeleteConfirm)
{
    <dialog class="modal-shell" data-school-modal aria-labelledby="delete-title" style="width: 28rem" @onclick="CancelDelete">
        <div class="w-full max-w-md bg-white p-6 shadow-xl" @onclick:stopPropagation>
            <h2 id="delete-title" class="mb-2 text-lg font-semibold text-sangria">Confirm Delete</h2>
            <p class="mb-4">Are you sure you want to delete <strong>@deleteTargetName</strong>? This cannot be undone.</p>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p role="alert" class="mb-4 text-sangria">@errorMessage</p>
            }
            <div class="flex justify-end gap-3">
                <button type="button"
                        @onclick="CancelDelete"
                        class="border border-seabreeze px-4 py-2 hover:bg-seabreeze/50">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ExecuteDelete"
                        disabled="@isSubmitting"
                        class="bg-sangria px-4 py-2 text-white hover:bg-sangria/90 disabled:opacity-60">
                    @(isSubmitting ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </dialog>
}

@code {
    private LearnerListResult? result;
    private List<GradeLevelOption> gradeLevelOptions = [];
    private List<SectionOption> sectionOptions = [];
    private bool isLoading = true;
    private int loadSequence;
    private bool isSubmitting;
    private string errorMessage = "";
    private string successMessage = "";

    private string searchText = "";
    private Guid? selectedGradeLevelId;
    private Guid? selectedSection;
    private int currentPage = 1;
    private string selectedStatus = "";

    private CancellationTokenSource? searchCts;
    public void Dispose() { searchCts?.Cancel(); searchCts?.Dispose(); }

    private bool showFormModal;
    private bool isOpeningForm;
    private bool isEditMode;
    private SectionOption? inactiveSection;
    private string previousSectionName = "";
    private IEnumerable<SectionOption> FormSections => sectionOptions.Concat(inactiveSection is null ? [] : new[] { inactiveSection }).Where(s => s.GradeLevelId == formModel.GradeLevelId);
    private LearnerFormModel formModel = new();
    private string editStatus = "Enrolled";
    private long editVersion;

    private bool showDeleteConfirm;
    private Guid deleteTargetId;
    private string deleteTargetName = "";

    private static readonly Guid CurrentInstitutionId =
        Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await LoadDropdownsAsync();
    }

    private async Task<bool> LoadDropdownsAsync()
    {
        try
        {
            gradeLevelOptions = await LearnerService.GetGradeLevelOptionsAsync(CurrentInstitutionId);
            // Refresh when opening a form as well as on initial page load,
            // so changes made in another tab appear in the choices.
            sectionOptions = await SectionService.GetSectionOptionsAsync(CurrentInstitutionId, null);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dropdown options");
            errorMessage = "Failed to load dropdown options. Please try again.";
            return false;
        }
    }

    private async Task LoadDataAsync()
    {
        var sequence = ++loadSequence;
        isLoading = true;
        errorMessage = "";

        try
        {
            var filter = new LearnerFilter(
                InstitutionId: CurrentInstitutionId,
                SearchText: searchText,
                GradeLevelId: selectedGradeLevelId,
                SectionName: null,
                Status: string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus,
                SectionId: selectedSection, Page: currentPage);

            var loaded = await LearnerService.GetLearnersAsync(filter);
            if (sequence != loadSequence) return;
            result = loaded;
            currentPage = result.Page;
        }
        catch (Exception ex)
        {
            if (sequence != loadSequence) return;
            Logger.LogError(ex, "Failed to load learners");
            errorMessage = "Failed to load learners. Please try again.";
        }
        finally
        {
            if (sequence == loadSequence) isLoading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        currentPage = 1;

        searchCts?.Cancel();
        searchCts?.Dispose();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(300, token);

            if (!token.IsCancellationRequested)
            {
                await LoadDataAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PreviousPage() { currentPage--; await LoadDataAsync(); }
    private async Task NextPage() { currentPage++; await LoadDataAsync(); }
    private async Task FilterChanged() { currentPage = 1; await LoadDataAsync(); }

    private async Task ClearFilters()
    {
        searchText = "";
        currentPage = 1;
        selectedGradeLevelId = null;
        selectedSection = null;
        selectedStatus = "";
        await LoadDataAsync();
    }

    private void FormGradeChanged() { formModel.SectionId = null; }

    private async Task OpenAddModal()
    {
        if (isOpeningForm) return;
        isOpeningForm = true;
        try
        {
            errorMessage = "";
            successMessage = "";
            if (!await LoadDropdownsAsync()) return;
            inactiveSection = null;
            previousSectionName = "";
            isEditMode = false;
            formModel = new LearnerFormModel();
            editStatus = "Enrolled";
            editVersion = 0;
            showFormModal = true;
        }
        finally { isOpeningForm = false; }
    }

    private async Task OpenEditModal(Guid learnerId)
    {
        if (isOpeningForm) return;
        isOpeningForm = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            if (!await LoadDropdownsAsync()) return;
            // Editing needs stored name fields and every editable value, not a display summary.
            var detail = await LearnerService.GetDetailByIdAsync(learnerId);
            if (detail is null)
            {
                errorMessage = "Learner not found. They may have been deleted.";
                return;
            }

            previousSectionName = detail.SectionId is null ? detail.SectionName : "";
            inactiveSection = detail.SectionId is { } sectionId && !sectionOptions.Any(s => s.Id == sectionId)
                ? new SectionOption(sectionId, detail.SectionName, detail.SectionName + " (current inactive section)", detail.GradeLevelId) : null;
            isEditMode = true;
            formModel = new LearnerFormModel
            {
                Id = detail.Id,
                FirstName = detail.FirstName,
                MiddleName = detail.MiddleName,
                LastName = detail.LastName,
                Lrn = detail.Lrn,
                Sex = detail.Sex,
                BirthDate = detail.BirthDate,
                GradeLevelId = detail.GradeLevelId,
                SectionId = detail.SectionId,
                GuardianName = detail.GuardianName,
                GuardianContact = detail.GuardianContact
            };
            editStatus = detail.Status;
            editVersion = detail.Version;

            showFormModal = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load learner details");
            errorMessage = "Failed to load learner details. Please try again.";
        }
        finally { isOpeningForm = false; }
    }

    private void CloseModal()
    {
        if (isSubmitting) return;
        showFormModal = false;
        errorMessage = "";
    }

    private async Task HandleFormSubmit()
    {
        if (isSubmitting) return;
        if (formModel.GradeLevelId == Guid.Empty)
        {
            errorMessage = "Please select a grade level.";
            return;
        }

        isSubmitting = true;
        errorMessage = "";

        try
        {
            if (isEditMode)
            {
                var request = new UpdateLearnerRequest(
                    Id: formModel.Id,
                    GradeLevelId: formModel.GradeLevelId,
                    Lrn: formModel.Lrn,
                    FirstName: formModel.FirstName,
                    MiddleName: formModel.MiddleName,
                    LastName: formModel.LastName,
                    Sex: formModel.Sex,
                    BirthDate: formModel.BirthDate ?? DateOnly.MinValue,
                    SectionName: "",
                    Status: editStatus,
                    GuardianName: formModel.GuardianName,
                    GuardianContact: formModel.GuardianContact,
                    Version: editVersion, SectionId: formModel.SectionId);

                await LearnerService.UpdateAsync(request);
                successMessage = "Learner updated successfully.";
            }
            else
            {
                var request = new CreateLearnerRequest(
                    InstitutionId: CurrentInstitutionId,
                    GradeLevelId: formModel.GradeLevelId,
                    Lrn: formModel.Lrn,
                    FirstName: formModel.FirstName,
                    MiddleName: formModel.MiddleName,
                    LastName: formModel.LastName,
                    Sex: formModel.Sex,
                    BirthDate: formModel.BirthDate ?? DateOnly.MinValue,
                    SectionName: "",
                    GuardianName: formModel.GuardianName,
                    GuardianContact: formModel.GuardianContact, SectionId: formModel.SectionId);

                await LearnerService.CreateAsync(request);
                successMessage = "Learner added successfully.";
            }

            showFormModal = false;
            await LoadDataAsync();
            await LoadDropdownsAsync();
        }
        catch (EnrollmentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An unexpected error occurred");
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ConfirmDelete(Guid id, string name)
    {
        deleteTargetId = id;
        deleteTargetName = name;
        showDeleteConfirm = true;
        errorMessage = "";
        successMessage = "";
    }

    private void CancelDelete()
    {
        if (isSubmitting) return;
        showDeleteConfirm = false;
    }

    private async Task ExecuteDelete()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        errorMessage = "";

        try
        {
            await LearnerService.DeleteAsync(deleteTargetId);
            successMessage = $"{deleteTargetName} has been deleted.";
            showDeleteConfirm = false;
            await LoadDataAsync();
            await LoadDropdownsAsync();
        }
        catch (EnrollmentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete learner");
            errorMessage = "Failed to delete learner. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class LearnerFormModel
    {
        public Guid Id { get; set; }

        [StringLength(100)]
        [Required(ErrorMessage = "First name is required.")]
        public string FirstName { get; set; } = "";

        [StringLength(100)]
        public string MiddleName { get; set; } = "";

        [StringLength(100)]
        [Required(ErrorMessage = "Last name is required.")]
        public string LastName { get; set; } = "";

        [RegularExpression(EnrollmentValidation.LrnPattern, ErrorMessage = "LRN must contain exactly 12 digits.")]
        [Required(ErrorMessage = "LRN is required.")]
        public string Lrn { get; set; } = "";

        [Required(ErrorMessage = "Sex is required.")]
        public string Sex { get; set; } = "";

        [PastOrToday(ErrorMessage = "Birth date must be no later than today.")]
        [Required(ErrorMessage = "Birth date is required.")]
        public DateOnly? BirthDate { get; set; }

        public Guid GradeLevelId { get; set; }

        public Guid? SectionId { get; set; }

        [StringLength(200)]
        public string GuardianName { get; set; } = "";

        [StringLength(50)]
        public string GuardianContact { get; set; } = "";
    }
}